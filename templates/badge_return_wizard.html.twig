{# Badge return wizard (BadgeReturn::showBadgeReturn()). #badges_informations is filled
   with badge_return_info.html.twig when a badge is selected. #}
<div class="container-lg my-3">
    <form name="wizard_form" id="badges_wizardForm" method="post">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-receipt-refund me-2"></i>{{ __('Access badge return', 'badges') }}
                </h3>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label required">{{ __('Badges in your possession', 'badges') }}</label>
                        <div>
                            {{ dropdown_html|raw }}
                            <script>{{ load_badge_info_js|raw }}</script>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">{{ __('Restitution date', 'badges') }}</label>
                        <div class="form-control-plaintext">{{ return_date_now }}</div>
                    </div>
                    <div class="col-12" id="badges_informations"></div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary"
                        onclick="badges_cancel('{{ cancel_url|e('js') }}');">
                    <i class="ti ti-arrow-left me-1"></i>{{ _x('button', 'Cancel') }}
                </button>
                <button type="button" class="btn btn-primary"
                        onclick="badges_returnBadges('returnBadges','badges_wizardForm');">
                    <i class="ti ti-receipt-refund me-1"></i>{{ __('Badges return', 'badges') }}
                </button>
            </div>
        </div>
        <input type="hidden" name="requesters_id" value="{{ requesters_id }}">
        <div id="dialog-confirm"></div>
    </form>
    <script>$(document).ready(function() {badges_initJs("{{ web_dir|e('js') }}");});</script>
</div>
