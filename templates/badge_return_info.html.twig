{% for row in rows %}
    <div class="card card-sm bg-secondary-lt mb-2">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-6 col-md-3">{{ __('Visitor firstname', 'badges') }}</dt>
                <dd class="col-6 col-md-3">{{ row.visitor_firstname }}</dd>
                <dt class="col-6 col-md-3">{{ __('Visitor realname', 'badges') }}</dt>
                <dd class="col-6 col-md-3">{{ row.visitor_realname }}</dd>
                <dt class="col-6 col-md-3">{{ __('Visitor society', 'badges') }}</dt>
                <dd class="col-6 col-md-3 mb-md-0">{{ row.visitor_society }}</dd>
                <dt class="col-6 col-md-3">{{ __('Arrival date', 'badges') }}</dt>
                <dd class="col-6 col-md-3 mb-0">{{ row.affectation_date }}</dd>
            </dl>
        </div>
    </div>
{% endfor %}
